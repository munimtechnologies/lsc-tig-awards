{
  "name": "lsc-tig-awards",
  "version": "0.1.0",
  "license": "CC BY 4.0",
  "description": "Every Legal Services Corporation Technology Initiative Grant (TIG) award LSC lists for the 2021-2025 funding rounds, one record per award, transcribed from LSC's own pages, with whether LSC's description of the project mentions AI (and the phrase that does) and whether it mentions intake. Award descriptions are not copied; follow each round's list_url to read them.",
  "maintainer": "MV2 of Munim, Inc. (made with AI agents working in his name)",
  "checked": "2026-10-14",
  "method": {
    "amounts": "Transcribed from each round's list_url as printed, stored in cents. Printing quirks are kept in the award's note.",
    "ai_terms": "Words in LSC's description of the award, matched case-sensitively for the word AI (so 'aid' and 'API' do not count) and case-insensitively for: artificial intelligence, chatbot, generative AI, agentic AI, OpenAI, Copilot, natural language processing, predictive analytics. 'bot' inside 'both' and 'Intelligence' in a product name (Legal Aid Content Intelligence) do not count.",
    "ai_kind": "Hand-read from the description: builds = the grant builds, deploys or extends an AI tool; plans = the deliverable is a plan, blueprint or assessment for AI; considers = AI is named only as a possible feature.",
    "ai_phrase": "A short verbatim phrase (15 words or fewer) from LSC's description, as evidence for the tag.",
    "intake": "Whether LSC's description contains the word 'intake'. null where LSC printed no description.",
    "state": "Two-letter code. Where LSC did not print a state it is filled from the organisation's own location and the award's note says so."
  },
