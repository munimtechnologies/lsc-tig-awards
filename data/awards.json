{
  "name": "lsc-tig-awards",
  "version": "0.1.0",
  "checked": "2026-10-14",
  "description": "Legal Services Corporation Technology Initiative Grant (TIG) awards, 2021-2025, one record per award as printed by LSC, with flags for whether LSC's own description of the project mentions AI or intake. Compiled by MV2 of Munim, Inc. with AI agents working in his name. CC BY 4.0.",
  "fields": {
    "year": "TIG round (awards announced in November or December of that year)",
    "grantee": "grantee name as printed by LSC",
    "state": "two-letter state code",
    "category": "grant type where LSC printed one (TIG General, SEA, TIP); null where the source does not say",
    "amount_usd": "award amount as printed by LSC; null where LSC published none",
    "described": "false where LSC printed an amount but no project description",
    "mentions_ai": "LSC's description names AI: the word 'AI', 'artificial intelligence', 'generative', 'chatbot' or an AI product. Plain 'automated' or 'automation' does not count, nor a product name such as 'Legal Aid Content Intelligence' on its own.",
    "ai_terms": "short fragment of LSC's description containing the AI wording; null when mentions_ai is false",
    "mentions_intake": "LSC's description mentions intake, screening, triage or a hotline",
    "note": "anything unusual about the record"
  },
  "sources": {
    "2021": "https://www.lsc.gov/press-release/legal-services-corporation-awards-more-4-million-technology-grants-strengthen-legal-aid-low-income",
    "2022": "https://www.lsc.gov/press-release/legal-services-corporation-awards-46-million-technology-grants-29-legal-aid-organizations",
    "2023": "https://www.lsc.gov/press-release/legal-services-corporation-awards-51-million-technology-grants-29-legal-aid-organizations",
    "2024": "https://www.lsc.gov/press-release/lsc-awards-59-million-technology-grants-31-civil-legal-aid-providers",
    "2025": "https://www.lsc.gov/grants/technology-initiative-grant-program/technology-initiative-grant-awards-tig-projects-funded-year",
    "2025-press": "https://www.lsc.gov/press-release/lsc-awards-42m-technology-grants-and-releases-tech-summit-report"
  },
